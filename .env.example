# 匹配设置
EMBEDDING_PROVIDER=qwen
MATCH_THRESHOLD=0.70
DATABASE_PATH=data/lost_found.db
REQUEST_TIMEOUT=30

# 通义 Embedding（当前默认）
DASHSCOPE_API_KEY=
QWEN_EMBEDDING_MODEL=text-embedding-v3
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings

# 智谱 Embedding（切换 EMBEDDING_PROVIDER=zhipu 时使用）
ZHIPU_API_KEY=
ZHIPU_EMBEDDING_MODEL=embedding-3
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/embeddings

# 本地 BGE（切换 EMBEDDING_PROVIDER=local 时使用）
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5


